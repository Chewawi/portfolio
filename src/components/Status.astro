---
import { Image } from "astro:assets";
import { getCodeStatus, getSpotifyStatus } from "~/lib/lanyard/api";

const codeStatus = await getCodeStatus();
const spotifyStatus = await getSpotifyStatus();
---

<div class="status-container">
    <div class="status-item">
        <Image
            src="/icons/spotify.png"
            alt="Spotify"
            draggable="false"
            width={30}
            height={30}
        />
        {
            spotifyStatus ? (
                <span class="status-text">
                    Listening to
                    <span class="status-bold">
                        <br />
                        {spotifyStatus.song} · {spotifyStatus.artist}
                    </span>
                </span>
            ) : (
                <span class="status-text">Not listening to anything</span>
            )
        }
    </div>
    <div class="status-item">
        <Image
            src="/icons/vscode.png"
            alt="Vscode"
            draggable="false"
            width={30}
            height={30}
        />
        {
            codeStatus ? (
                <span class="status-text">
                    Working on
                    <span class="status-bold">
                        <br />
                        {codeStatus.state ?? "some project"}
                    </span>
                </span>
            ) : (
                <span class="status-text">Not working</span>
            )
        }
    </div>
</div>

<style>
    .status-container {
        margin-top: 109.9px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        text-transform: none;
        gap: 15px;
        align-items: flex-start;
    }

    .status-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-text {
        font-size: 1.5rem;
    }

    .status-bold {
        font-weight: bold;
    }

    br {
        display: none;
    }

    @media (max-width: 768px) {
        .status-container {
            display: none;
            margin-top: 20px;
            align-items: center;
        }

        .status-item {
            text-align: center;
            justify-content: center;
        }

        .status-text {
            font-size: 1rem;
        }

        br {
            display: block;
        }
    }
</style>
