---
import { Image } from "astro:assets";
import Github from "lucide-static/icons/github.svg";
import Linkedin from "lucide-static/icons/linkedin.svg";
import { getDiscordUser } from "~/lib/lanyard/api";

const user = await getDiscordUser();
---

<div class="header-container">
    <div class="header-content">
        <div class="avatar-container">
            <div class="avatar">
                <Image
                    src={`https://cdn.discordapp.com/avatars/852970774067544165/${user.avatar}`}
                    alt={`${user.username}`}
                    width={200}
                    height={200}
                />
            </div>
        </div>
        <div class="links">
            <a
                href="https://github.com/chewawi"
                target="_blank"
                rel="noopener noreferrer"
                class="link"
            >
                <Github size={30} />
                <span>GitHub</span>
            </a>
            <a
                href="/linkedin"
                target="_blank"
                rel="noopener noreferrer"
                class="link"
            >
                <Linkedin size={30} />
                <span>Linkedin</span>
            </a>
        </div>
    </div>
</div>

<style>
    .header-container {
        position: sticky;
        top: 0rem;
        width: 100%;

        padding-bottom: 2.5rem;
        padding-top: 2.5rem;
    }

    .header-content {
        width: 100%;
        flex-direction: row;
        max-width: 95rem;
        margin-inline: auto;
        padding-inline: 1rem;

        position: relative;
        display: flex;
        justify-content: space-between;
        flex-direction: row;
        align-items: center;
        gap: 10px;
    }

    .avatar-container {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-direction: row;
        position: relative;
    }

    .avatar {
        width: 5.5em;
        height: 5.2em;

        display: flex;
        flex: 0 0 auto;
        border-radius: 9999px;
        overflow: hidden;
        position: absolute;
        align-items: center;
        justify-content: center;
    }

    .avatar img {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .links {
        display: flex;
        align-items: center;
        flex-direction: row;
        gap: 35px;
    }

    .link {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 10px;
        text-decoration: none;
        color: white;
        transition: color 0.2s;

        font-size: 1.2rem;
    }

    .link:hover {
        color: gray;
    }

    @media (max-width: 768px) {
        .links {
            gap: 20px;
        }

        .link {
            gap: 5px;
        }

        .link span {
            display: none;
        }

        .header-content {
            gap: 15px;
        }
    }
</style>
