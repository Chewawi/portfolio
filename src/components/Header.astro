---
import Github from "lucide-static/icons/github.svg";
import Linkedin from "lucide-static/icons/linkedin.svg";
import Avatar from "./Avatar.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
---

<div class="header-container">
    <div class="header-content">
        <Avatar />
        <ThemeSwitch />
        <div class="links">
            <a
                href="https://github.com/chewawi"
                target="_blank"
                rel="noopener noreferrer"
                class="link"
            >
                <Github size={30} />
                <span>GitHub</span>
            </a>
            <a
                href="/linkedin"
                target="_blank"
                rel="noopener noreferrer"
                class="link"
            >
                <Linkedin size={30} />
                <span>Linkedin</span>
            </a>
        </div>
    </div>
</div>

<style>
    .header-container {
        position: sticky;
        top: 0rem;
        width: 100%;

        padding-bottom: 2.5rem;
        padding-top: 2.5rem;
    }

    .header-content {
        flex-direction: row;
        max-width: 95rem;
        margin-inline: auto;
        padding-inline: 2.2rem;

        position: relative;
        display: flex;
        justify-content: space-between;
        flex-direction: row;
        align-items: center;
        gap: 10px;
    }

    .links {
        display: flex;
        align-items: center;
        flex-direction: row;
        gap: 35px;
    }

    .link {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 10px;
        text-decoration: none;
        color: var(--text-primary);
        transition: color 0.2s;

        font-size: 1.2rem;
    }

    .link:hover {
        color: var(--text-secondary);
    }

    @media (max-width: 768px) {
        .links {
            gap: 20px;
        }

        .link {
            gap: 5px;
        }

        .link span {
            display: none;
        }

        .header-content {
            gap: 15px;
        }
    }
</style>
